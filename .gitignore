# Go build output and local databases
/server/bin/
*.db
*.db-wal
*.db-shm

# Dart and Flutter tooling
.dart_tool/
/app/build/

# The brand tool is dev tooling that must work on every Dart version from its
# minimum up, so its dependencies are resolved fresh instead of being locked.
/app/tool/brand/pubspec.lock

# Generated by `make app-setup` from the app's own sources: the translations (gen-l10n)
# and the database code (build_runner). Never edit or commit these.
/app/lib/l10n/
/app/lib/core/db/database.g.dart

# Generated by `make brand` (app/tool/brand) from the brand folder. Never edit
# or commit these. This list must match ownedFiles and ownedDirectories in
# app/tool/brand/lib/src/generator.dart; a test checks that it does.
/app/lib/brand/brand.g.dart
/app/lib/brand/themes.g.dart
/app/android/brand.properties
/app/android/app/src/brand/
/app/android/app/google-services.json
/app/ios/Flutter/Brand.xcconfig
/app/ios/Runner/Assets.xcassets/AppIcon.appiconset/
/app/macos/Runner/Configs/Brand.xcconfig
/app/macos/Runner/Assets.xcassets/AppIcon.appiconset/
/app/windows/brand.cmake
/app/windows/runner/resources/app_icon.ico
/app/linux/brand.cmake
/app/linux/brand/
/app/assets/brand/
/app/fastlane/metadata/android/en-US/title.txt
/app/fastlane/metadata/android/en-US/short_description.txt
/app/fastlane/metadata/en-US/name.txt
/app/fastlane/metadata/en-US/privacy_url.txt
/app/fastlane/metadata/en-US/support_url.txt
/app/fastlane/metadata/en-US/marketing_url.txt
